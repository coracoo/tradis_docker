{
  "schemaVersion": 1,
  "state": "worktree-candidate-verified",
  "releaseReadiness": {
    "actualApprovedRefExport": false,
    "localRuntimeSmoke": true,
    "realDockerSmoke": true,
    "externalServiceSmoke": false,
    "redistributionRightsReview": false,
    "publicRepository": true,
    "publicRepositoryUrl": "https://github.com/coracoo/tradis_docker",
    "publicImage": false,
    "signedReleaseManifest": {
      "done": false,
      "gate": "self-update-prerequisite",
      "note": "发布决策 2026-09-29（方案 B）：签名清单是将来启用 Community 自动更新的前置条件，不是公开发布的阻塞项。公开发布时承诺仅手动更新（docker pull），README 注明从官方源拉取并校验 digest。启用自动更新前必须实现独立公钥签名清单，且更新通道必须复用 pkg/selfupdate 引擎、以 edition 策略注入签名验证，禁止复制平行实现。"
    }
  },
  "edition": {
    "id": "tradis-community",
    "buildTag": "community",
    "description": "Standalone local Docker management edition without TRADIS official Server dependencies"
  },
  "exportPolicy": {
    "default": "deny",
    "requireExactFileClassification": true,
    "allowDirectoryGlobs": false,
    "generatedManifestIsAuthoritative": true,
    "preserveGitHistory": false,
    "excludeNodeModules": true
  },
  "publicEntryPoints": [
    "client/backend/cmd/main.go",
    "client/backend/cmd/community_runtime.go",
    "client/backend/api/community_routes.go",
    "client/frontend/src/main.js",
    "client/frontend/src/community/routes.js"
  ],
  "sharedSubsystems": [
    "local Docker resource management",
    "manual Compose deployment and history",
    "local tasks and SSE",
    "volume backup to user-controlled storage",
    "scheduled local Docker tasks",
    "external notification channels",
    "CDN-only AppStore template deployment",
    "user-configured navigation and Compose AI",
    "read-only public CDN tutorials",
    "read-only public CDN NAS guide"
  ],
  "excludedSubsystems": [
    "pkg/license",
    "api/license.go",
    "api/ai_agent_*.go",
    "api/github_apps.go",
    "api/tutorials.go",
    "api/environments.go",
    "api/environment_profile_routes_full.go",
    "api/environment_routes_full.go",
    "frontend/api/settings_full.js",
    "api/remote_*.go",
    "pkg/remoteagent",
    "pkg/remotedeployment",
    "pkg/remoteresource",
    "api/protection*.go",
    "pkg/protection",
    "api/safe_updates.go",
    "pkg/updateflow",
    "api/nas_proxy.go",
    "api/mcp_icons.go",
    "api/self_update.go",
    "pkg/selfupdate"
  ],
  "forbiddenImportPrefixes": [
    "dockerpanel/backend/pkg/license",
    "dockerpanel/backend/pkg/officialhttp",
    "dockerpanel/backend/pkg/remoteagent",
    "dockerpanel/backend/pkg/remotedeployment",
    "dockerpanel/backend/pkg/remoteresource",
    "dockerpanel/backend/pkg/protection",
    "dockerpanel/backend/pkg/updateflow"
  ],
  "forbiddenRuntimeEndpoints": [
    "/api/license/",
    "/api/github-apps/",
    "/api/ai/agent/",
    "/api/environments/",
    "/api/protection/",
    "/api/safe-updates/",
    "/api/nas/redirect/",
    "/api/nas/import",
    "/api/nas/device",
    "/api/self-update/"
  ],
  "communityNetworkAllowlist": [
    "user-configured Docker registries",
    "user-configured Git source URLs",
    "user-configured S3 or WebDAV backup endpoints",
    "user-configured notification endpoints",
    "configured AppStore CDN",
    "configured public tutorial CDN",
    "future signed Community release manifest"
  ],
  "communityNetworkDenylist": [
    "TRADIS official license service",
    "TRADIS official AppStore origin fallback",
    "TRADIS official release check service",
    "TRADIS official NAS content service",
    "TRADIS Agent log upload service"
  ],
  "candidateExport": {
    "script": "scripts/export-community.sh",
    "backendClosure": "go list -deps -tags community ./cmd",
    "frontendClosure": "Community Vite source maps plus resolved local imports and exact static build inputs",
    "manifest": ".community-export-manifest.json",
    "secretGate": "scripts/check-community-export-secrets.sh",
    "verifiedFromCurrentWorktree": true,
    "verifiedFromTemporaryGitRef": true,
    "verifiedWithoutGitHistory": true,
    "verifiedWithoutNodeModules": true
  },
  "requiredBeforeExport": [
    "Run the export again from a committed --ref snapshot before publishing",
    "Review the generated exact file manifest and hashes",
    "Run an import and runtime endpoint audit against the exported directory",
    "Run the automated secret gate and manually review media, template and documentation redistribution rights",
    "Build and test the exported directory independently"
  ]
}
