# 首次启动必填；使用随机密钥和自己的管理员密码。
JWT_SECRET=
ADMIN_PASSWORD=
TRADIS_PORT=8080

# 两版共用此示例；同时安装时必须使用不同的安装目录、端口和项目目录。
# 项目使用宿主机绝对路径，默认备份保存在安装目录 data/backups。
PROJECT_ROOT=/opt/tradis/projects
# Community only; Full reads the official template service.
APPSTORE_CDN_URL=https://github.com/coracoo/tradis_templates
CLOUDFLARE_SPEED_TEST=false

# 仅社区版使用；也可填写发布页的 image@sha256:digest 固定版本。
TRADIS_COMMUNITY_IMAGE=ghcr.io/coracoo/tradis_docker:latest

# 可选：生产环境限制浏览器来源，例如 https://tradis.example.com。
ALLOWED_ORIGINS=*
