# Community 本地开源构建候选示例。该版本尚未公开发布；不要将其数据目录或项目目录复用到私有 Full / Go 实例。
# 使用：cp .env.community.example .env，填写镜像 digest 后运行 Compose。

# 首次启动必填，留空时 Compose 拒绝启动。JWT_SECRET 至少 32 个字符；请使用随机值，不要保留占位文本。
JWT_SECRET=
ADMIN_PASSWORD=

# 容器对外端口。
TRADIS_PORT=8080
# 正式安装：填写发布页给出的 image@sha256:digest，不使用占位或不明镜像。
# 源码构建：填写 tradis-community:local 并添加 docker-compose.community.build.yml。
TRADIS_COMMUNITY_IMAGE=

# 本机 Compose 项目的宿主机绝对目录。该目录会以相同绝对路径映射进容器。
PROJECT_ROOT=/opt/tradis-community/projects

# 卷备份归档目录，建议位于 PROJECT_ROOT 之外。
BACKUP_ROOT=/opt/tradis-community/backups

# 只读 AppStore CDN。留空时仍可使用已有本地模板缓存。
APPSTORE_CDN_URL=https://tradis-templates.coracoo.deno.net

# 可选：设置为 true 才会下载并运行 CDN 优选 IP 测速。
CLOUDFLARE_SPEED_TEST=false

# 生产环境可限制浏览器来源，例如：https://tradis.example.com
ALLOWED_ORIGINS=*
